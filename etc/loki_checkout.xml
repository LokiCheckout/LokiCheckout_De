<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:LokiCheckout_Core:etc/loki_checkout.xsd">
    <grid_layouts>
        <grid_layout name="default_grid">
            <grid name="germany" countryId="DE" parent="default">
                <block alias="postcode" sortOrder="50" mdColSpan="3"/>
                <block alias="city" sortOrder="60" mdColSpan="9"/>
                <block alias="street0" sortOrder="70"/>
                <block alias="street1" sortOrder="80" mdColSpan="3"/>
                <block alias="street2" sortOrder="90" mdColSpan="3"/>
                <block alias="street3" sortOrder="100"/>
                <block alias="region" sortOrder="110"/>
                <block alias="country_id" sortOrder="120" mdColSpan="12"/>
            </grid>
        </grid_layout>
    </grid_layouts>
</config>
